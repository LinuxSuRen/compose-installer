# Build matrix of the docker-offline installer image (read by CI, one version per line).
# Format: target image tag = base image for the build (source of the binaries)
# Artifacts are pushed to ghcr.io/linuxsuren/compose-installer/docker-offline:<tag>.
# CI builds both amd64 and arm64 (the packer extracts materials per target
# architecture); base images must be multi-arch too.
latest=docker:27.5.1-dind
27.5.1-dind=docker:27.5.1-dind
