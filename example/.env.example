# Demo project env template. Copied into the target .env and extended with:
#   NGINX_TAG / HTTP_ECHO_TAG  from the selected version manifest
#   APP_VERSION                from envExports ({version})
#   DEMO_DATA_DIR              from envRewrites ({installDir}/data)
# User-provided overrides (Install page env fields) always win.

WEB_PORT=8080
DEMO_API_TOKEN=
DEMO_DATA_DIR=/var/lib/demo
